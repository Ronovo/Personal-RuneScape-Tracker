# Long random secret that signs every API token — personal JWTs (public host)
# and the LAN wildcard token. Required for any authentication at all. Keep it
# stable; changing it invalidates every issued token.
JWT_SECRET=

# Set to 1 for LAN / friend-group posture. The server mints one stable wildcard
# API token (access to any player, no account), prints it on startup, and the
# browser picks it up automatically. Requires JWT_SECRET.
# NEVER set this on an internet-exposed host — /api/auth/status hands the token
# to any caller.
LAN_MODE=

# Optional comma-separated RS display names allowed to sync or read player
# data. Applies to the LAN wildcard token. Unset = any valid username.
SYNC_ALLOWED_USERS=

# In-process /api rate limit. 0 disables (tests do this).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Stricter limit on /api/auth/{login,register,token}, keyed by IP + submitted
# email. Brute-force protection on the credential endpoints.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Set ONLY when a reverse proxy terminates connections in front of the app:
# "1" (hop count) or an Express preset like "loopback". Makes rate limiting
# key on the real client IP and lets HSTS fire behind the proxy. Leave unset
# for a direct LAN host.
TRUST_PROXY=

# Contact string added to the outbound User-Agent on OSRS Wiki API calls.
# Defaults to the project repo URL.
WIKI_API_CONTACT=

PORT=4123
SYNC_DATA_DIR=
WATCHLIST_DATA_DIR=
USERS_DATA_DIR=
